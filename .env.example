# Revenue Engine runtime
ENVIRONMENT=development
FLASK_SECRET_KEY=generate-a-long-random-secret-before-deployment
# Replit supplies its managed DATABASE_URL per environment. Set it manually only
# when using an external PostgreSQL service; never copy the value into this file.
DATABASE_URL=
# auto uses PostgreSQL when DATABASE_URL is set; use sqlite only for local development/tests.
DATABASE_BACKEND=auto
# SQLite-only local-development path; production will not fall back to this file.
OUTREACH_DB=data/revenue_engine.db
LANDING_PAGE_URL=https://sanchit-agarwal.me/

# Owner dashboard and notifications (never publish these values)
OWNER_DASHBOARD_PASSWORD=set-a-unique-long-owner-password-in-deployment-secrets
OWNER_NOTIFICATION_EMAIL=your-owner-inbox@example.com
PUBLIC_APP_URL=https://your-replit-app.replit.app

# Hugging Face Inference Providers; token needs Inference Providers permission
HF_TOKEN=
HF_API_URL=https://router.huggingface.co/v1/chat/completions
HF_MODEL=meta-llama/Llama-3.1-8B-Instruct:fastest
# Legacy compatibility with the prior Replit receiver
HF_API_KEY=

# Legacy Google Places setting. Export-style prospect discovery is retired; do not configure it for the acquisition worker.
GOOGLE_API_KEY=

# Background acquisition switch: keep false until production schema, credentials,
# market validation, mail receiver/webhook, and end-to-end acceptance checks pass.
REVENUE_ENGINE_AUTOMATION_ENABLED=false

# Transactional delivery provider: brevo or sendgrid
EMAIL_PROVIDER=brevo
BREVO_API_KEY=
BREVO_SENDER=
BREVO_REPLY_TO=
# Used as a Bearer token for Brevo delivery-event and inbound-parse webhooks
BREVO_WEBHOOK_TOKEN=

# Alternate delivery provider (keep disabled unless its entitlement/sender is verified)
SENDGRID_API_KEY=
SENDGRID_SENDER=
SENDGRID_REPLY_TO=

# Razorpay Test Mode API credentials. Keep the key secret on the server only.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Leave false until a separately approved live-payment launch.
RAZORPAY_LIVE_PAYMENTS_ENABLED=false

# Razorpay Dashboard -> Webhooks -> secret for signing webhook events.
# This is NOT the Razorpay API key secret.
RAZORPAY_WEBHOOK_SECRET=

# Conservative campaign controls
CAMPAIGN_LIMIT=5
DAILY_LIMIT=10
MIN_SEND_DELAY=8
MAX_SEND_DELAY=20
DOMAIN_COOLDOWN=3600
MAX_CONSECUTIVE_FAILURES=3

# Country-focused market testing. India is the domestic baseline; choose one country/city per discovery run.
# Keep true: live outreach is blocked until the selected country has a recorded validation checklist in the owner dashboard.
TARGET_MARKET_COUNTRY=India
TARGET_MARKET_LANGUAGE=en
MARKET_VALIDATION_REQUIRED=true
